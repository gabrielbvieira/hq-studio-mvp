+// Opcional: com CHATGPT_IMAGE_TIMING_LOG, registra quanto cada passo no navegador levou (sem o conteúdo do pedido).
+function logTiming(args: string[], elapsedMs: number, exitCode: number | null): void {
+  const file = process.env.CHATGPT_IMAGE_TIMING_LOG;
+  if (!file) return;
+  const step = args.filter((arg) => !arg.startsWith("-s=")).slice(0, 1).join(" ");
+  const source = step === "run-code" ? (args.includes("--filename") ? "setInputFiles" : args.find((arg) => arg.includes("async page")) ?? "") : "";
+  // Nome do script pelo trecho que só ele tem; o código (com o pedido) nunca vai para o registro.
+  const script = !source ? "" : source.includes("setInputFiles") ? "upload-referencias"
+    : source.includes("composer.fill") ? "enviar-texto" : source.includes("loginRequired") ? "ler-pagina"
+    : source.includes("download") ? "baixar-imagem" : "outro";
+  const detail = script || args.filter((arg) => /^https?:/.test(arg)).join(" ");
+  try {
+    appendFileSync(file, `${new Date().toISOString()}\t${elapsedMs}ms\t${step}${detail ? " " + detail : ""}\texit=${exitCode}\n`);
+  } catch {
+    // O registro de tempo nunca pode atrapalhar a geração.
+  }
+}
