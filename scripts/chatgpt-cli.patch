+  /** Igual a runCode, mas lendo o código de um arquivo: sem o limite de tamanho de um argumento. */
+  async runCodeFile<T>(sessionName: string, filename: string, timeoutMs = 30_000): Promise<T> {
+    const execution = await this.execute(
+      [`-s=${sessionName}`, "run-code", "--filename", filename, "--json"],
+      { timeoutMs },
+    );
+    const outer = execution.json as { result?: unknown } | undefined;
+    if (typeof outer?.result === "string") {
+      try {
+        return JSON.parse(outer.result) as T;
+      } catch {
+        return outer.result as T;
+      }
+    }
+    return outer?.result as T;
+  }
